# 本地开发地址: 只在 dev(NODE_ENV 不是 production)时由 rspack.config.ts 读取
# 复制为 .env 后生效; .env 不进 git,也不影响 dist 产物,线上构建完全不读本文件
# DS_CHAT_PAGES_LINK 同时决定 dev 服务器的端口与主机,未设置时回落到 127.0.0.1:8090
DS_CHAT_PAGES_LINK=http://127.0.0.1:61117
# 下面两项分别覆盖 dsc-inner-plugin 与 awesome-dsc-plugin 的 Pages 来源地址
# 未设置或地址非法时仍用仓库里的线上地址
DSC_INNER_PLUGIN_PAGES_LINK=http://127.0.0.1:61118
AWESOME_DSC_PLUGIN_PAGES_LINK=http://127.0.0.1:61119

# 联调时的信任材料地址: 留空则开发构建不请求任何镜像,直接用构建内嵌的根证书与网页 EEC
# 需要走本地证书时, 用 tools/dev-static-server 把 dsce 的 certs 目录服务出来后填在这里
DS_CHAT_CERTS_LINK=
DS_CHAT_TRUSTED_MANIFEST_LINK=
